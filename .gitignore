# Claude Code harness runtime state (per-session locks etc.)
.claude/

# OS
.DS_Store
Thumbs.db

# Source data — large public ONS files, see data/source/README.md
data/source/*.xlsx
data/source/*.xls

# Raw cached ward boundary GeoJSON from scripts/09 (~50 MB GB-wide)
data/source/wd_may_2024_uk_bgc_*.geojson

# Raw cached Senedd 2026 boundary GeoJSON from scripts/16 (~8 MB).
# Re-fetchable from DataMapWales; skip-if-exists in 16.
data/source/senedd_final_2026.geojson

# Raw cached PCON_JUL_2024 (Westminster) boundary GeoJSON from scripts/21
# (~30–50 MB). Re-fetchable from ONS Open Geography Portal; skip-if-exists in 21.
data/source/pcon_jul_2024.geojson

# Raw cached LGBCE post-review CED shapefiles from scripts/09c (~15 MB zipped,
# ~37 MB extracted). Re-fetchable; the zips download idempotently.
data/source/lgbce/

# Raw cached ONS Open Geography Portal OA lookups from scripts/03b
# (~5–10 MB each; ~188k OAs in EW)
data/source/oa21_msoa21_lookup.csv
data/source/oa21_wd24_lookup.csv

# Cached Wikipedia article JSON from scripts/00, 00b, 10. Hundreds of files
# at ~200 KB each — re-fetchable; idempotent skip-if-exists means a fresh
# checkout just re-pulls them on first run.
data/source/wiki_*.json

# Cached official-source fetches from scripts/12 — HTML pages, ArcGIS/PowerBI
# JSON, PDFs, and ZIPs (PDF councils whose results live one PDF per ward
# get bundled into a single zip member-per-ward by _pdf_zip). Re-fetchable;
# skip-if-exists in 12. The extracted CSV (county_official_<year>.csv,
# ward_official_<year>.csv) IS committed.
data/source/official_*.html
data/source/official_*.json
data/source/official_*.pdf
data/source/official_*.zip

# Cached Surrey CC mycouncil + electionmap HTML fetches from scripts/22 —
# Incapsula-fronted so re-fetching may be rate-limited; the parsed
# surrey_2026.json IS committed so downstream renderers don't need
# these caches.
data/source/surrey_council_*.html
data/source/surrey_electionmap_*.html

# Built per-ward datasets that are reproducible from the cached wiki + geom files.
data/current_winners.json
data/current_winners_raw.json
data/ward_history.json
data/ced_history.json
data/holyrood_history.json


